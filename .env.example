# Runtime. `local` is the safe default; use `rain-sandbox` explicitly.
PORT=4173
ADAPTER_MODE=local

# Rain hackathon sandbox. The base URL is public; identifiers and API key are
# tenant-specific and must remain server-side. All UUID fields must be valid.
RAIN_API_BASE_URL=https://api-dev.raincards.xyz/v1
RAIN_API_KEY=
RAIN_USER_ID=
RAIN_TEAM_ID=
RAIN_CONTRACT_ID=

# Sandbox rUSD collateral amount in USD cents. Keep 0 during normal runs;
# provision deliberately once, then rely on the sandbox contract balance.
RAIN_AUTO_FUND_MINOR=0
RAIN_TIMEOUT_MS=12000

# Public Monad testnet and x402 readiness configuration. `local` performs only
# read-only health checks. `x402-testnet` enables the capped buyer adapter and
# must run only in an access-controlled local/private runtime.
MONAD_EXECUTION_MODE=local
MONAD_NETWORK=eip155:10143
MONAD_CHAIN_ID=10143
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
MONAD_PROBE_TIMEOUT_MS=5000
X402_FACILITATOR_URL=https://x402-facilitator.molandak.org
MONAD_USDC_ADDRESS=0x534b2f3A21130d7a60830c2Df862319e593943A3

# Live x402 buyer configuration. Never put the payer key in a public Vercel
# project. The payer must be a dedicated funded testnet wallet; pay-to must be
# a different seller wallet. The HTTPS seller must require and durably enforce
# the x402 payment-identifier extension before this mode is safe to run.
MONAD_PRIVATE_KEY=
MONAD_PAY_TO_ADDRESS=
X402_AVAILABILITY_BASE_URL=
X402_EXPECTED_AMOUNT_ATOMIC=10000
X402_MAX_PAYMENT_ATOMIC=10000
X402_MAX_AUTHORIZATION_SECONDS=300
X402_TIMEOUT_MS=12000
X402_PREFLIGHT_TTL_MS=60000
X402_RESPONSE_LIMIT_BYTES=65536
X402_EXPECTED_PROVIDER_ID=provider_atlas_archive
MONAD_X402_CONFIRMATIONS=6

# Reserved for a future deployed recovery-bounty registry. The current bounty,
# provider claim, attestations, and tranche releases remain a local ledger.
MONAD_BOUNTY_CONTRACT=
