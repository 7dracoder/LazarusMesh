# Runtime. `local` is the safe default; use `rain-sandbox` explicitly.
PORT=4173
ADAPTER_MODE=local

# Rain hackathon sandbox. The base URL is public; identifiers and API key are
# tenant-specific and must remain server-side. All UUID fields must be valid.
RAIN_API_BASE_URL=https://api-dev.raincards.xyz/v1
RAIN_API_KEY=
RAIN_USER_ID=
RAIN_TEAM_ID=
RAIN_CONTRACT_ID=

# Sandbox rUSD collateral amount in USD cents. Set to 0 to disable automatic
# funding only when the Rain contract is already funded.
RAIN_AUTO_FUND_MINOR=2000
RAIN_TIMEOUT_MS=12000

# Public Monad testnet and x402 readiness configuration. When both URLs are
# populated, GET /api/health performs read-only checks; execution stays local.
MONAD_NETWORK=eip155:10143
MONAD_CHAIN_ID=10143
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
MONAD_PROBE_TIMEOUT_MS=5000
X402_FACILITATOR_URL=https://x402-facilitator.molandak.org
MONAD_USDC_ADDRESS=0x534b2f3A21130d7a60830c2Df862319e593943A3

# Reserved live-write configuration. Leave empty: this release never signs a
# Monad transaction, calls a deployed bounty contract, or pays an x402 payee.
MONAD_PRIVATE_KEY=
MONAD_BOUNTY_CONTRACT=
MONAD_PAY_TO_ADDRESS=
