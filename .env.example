# Runtime. `local` is the safe default; use `rain-sandbox` explicitly.
# Vercel accepts both, but `rain-sandbox` also requires an explicit isolated
# LAZARUS_STATE_KEY so a local-mode snapshot is never adopted as card authority.
PORT=4173
ADAPTER_MODE=local

# Rain hackathon sandbox. The base URL is public; identifiers and API key are
# tenant-specific and must remain server-side. All UUID fields must be valid.
RAIN_API_BASE_URL=https://api-dev.raincards.xyz/v1
RAIN_API_KEY=
RAIN_USER_ID=
RAIN_TEAM_ID=
RAIN_CONTRACT_ID=

# Sandbox rUSD collateral amount in USD cents. Keep 0 during normal runs;
# provision deliberately once, then rely on the sandbox contract balance.
RAIN_AUTO_FUND_MINOR=0
RAIN_TIMEOUT_MS=12000

# Optional external merchant + artifact provider. `local` keeps the bundled
# Atlas simulation. `remote` enables authenticated HTTPS negotiation, pins the
# merchant's Ed25519 signing key, and accepts only the exact trusted manifest.
# Keep the bearer token and full manifest server-side. One remote deployment
# serves one configured accounting currency at a time.
MERCHANT_MODE=local
MERCHANT_BASE_URL=
MERCHANT_API_TOKEN=
MERCHANT_EXPECTED_KEY_ID=
MERCHANT_CURRENCY=
MERCHANT_TRUSTED_MANIFEST_JSON=
# Optional remote limits. Blank values use 5000 ms, 1 MiB per response/piece,
# and 32 MiB total respectively.
MERCHANT_TIMEOUT_MS=
MERCHANT_RESPONSE_LIMIT_BYTES=
MERCHANT_MAXIMUM_PIECE_BYTES=
MERCHANT_MAXIMUM_TOTAL_BYTES=

# Public Monad testnet and x402 readiness configuration. `local` performs only
# read-only health checks. `x402-testnet` enables the capped buyer adapter and
# must run only in an access-controlled local/private runtime.
MONAD_EXECUTION_MODE=local
MONAD_NETWORK=eip155:10143
MONAD_CHAIN_ID=10143
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
MONAD_PROBE_TIMEOUT_MS=5000
X402_FACILITATOR_URL=https://x402-facilitator.molandak.org
MONAD_USDC_ADDRESS=0x534b2f3A21130d7a60830c2Df862319e593943A3

# Live x402 buyer configuration. Prefer a dedicated Privy server wallet whose
# policy permits only Monad testnet USDC TransferWithAuthorization signatures.
# Keep its app secret server-side and scope it to an access-controlled preview;
# never expose it through public client variables. MONAD_PRIVATE_KEY remains a
# local-only fallback and must not be set together with the Privy variables.
PRIVY_APP_ID=
PRIVY_APP_SECRET=
PRIVY_PAYER_WALLET_ID=
PRIVY_PAYER_ADDRESS=
MONAD_PRIVATE_KEY=
MONAD_PAY_TO_ADDRESS=
X402_AVAILABILITY_BASE_URL=
X402_EXPECTED_AMOUNT_ATOMIC=10000
X402_MAX_PAYMENT_ATOMIC=10000
X402_MAX_AUTHORIZATION_SECONDS=300
X402_TIMEOUT_MS=12000
X402_PREFLIGHT_TTL_MS=60000
X402_RESPONSE_LIMIT_BYTES=65536
X402_EXPECTED_PROVIDER_ID=provider_atlas_archive
# Optional locally. Vercel injects the isolated preview state key so separate
# demo cycles cannot collide in the seller's global payment-ID ledger.
X402_PAYMENT_NAMESPACE=default
MONAD_X402_CONFIRMATIONS=6

# Receive-side x402 seller. On Vercel it is enabled only alongside the buyer in
# the protected branch Preview, uses the durable Neon settlement store, and is
# reached by a server-internal transport that cannot bypass to another origin.
X402_SELLER_ENABLED=false

# Vercel persistence and buyer safety boundary. Remote merchant deployments
# must override the state key with an isolated merchant-* value (for example,
# merchant-demo-production-v1); they never adopt the legacy primary state.
# Set the remaining buyer flags only on the protected feature-branch Preview.
# Production must keep MONAD_EXECUTION_MODE=local and omit Privy payer secrets.
ALLOW_EXTERNAL_WRITES_ON_VERCEL=false
LIVE_PREVIEW_BRANCH=
LAZARUS_STATE_KEY=primary

# Reserved for a future deployed recovery-bounty registry. The current bounty,
# provider claim, attestations, and tranche releases remain a local ledger.
MONAD_BOUNTY_CONTRACT=
